<xml>

	<set name="HXCPP_C_STANDARD" value="17" />
	<set name="HXCPP_CPP_STANDARD" value="17" />

	<include name="${HXCPP}/build-tool/BuildCommon.xml"/>

	<set name="LIME_BOX3D" value="1"/>

   <files id="box3d-depends">
      <depend name="lib/box3d/include/box3d/base.h" />
	  <depend name="lib/box3d/include/box3d/box3d.h" />
	  <depend name="lib/box3d/include/box3d/collision.h" />
	  <depend name="lib/box3d/include/box3d/config.h" />
	  <depend name="lib/box3d/include/box3d/constants.h" />
	  <depend name="lib/box3d/include/box3d/id.h" />
	  <depend name="lib/box3d/include/box3d/math_functions.h" />
	  <depend name="lib/box3d/include/box3d/types.h" />
   </files>

	<files id="box3d">
		<compilerflag value="-Ilib/box3d/include/" />
		<compilerflag value="-Ilib/box3d/include/box3d/" />
		<compilerflag value="/std:c17" if="isMsvc" /> <!-- current hxcpp haxelib version (4.3.2) doesnt have HXCPP_C_STANDARD -->
		<compilerflag value="-std=c17" unless="isMsvc" />
		<compilerflag value="/W4" if="isMsvc" />
		<compilerflag value="/wd4820" if="isMsvc" />
		<compilerflag value="/wd5045" if="isMsvc" />
		<compilerflag value="/wd4061" if="isMsvc" />
		<compilerflag value="/wd4711" if="isMsvc" />
		<compilerflag value="/wd4710" if="isMsvc" />
		<depend files="box3d-depends" />
		
		<file name="lib/box3d/src/aabb.c" />
		<file name="lib/box3d/src/arena_allocator.c" />
		<file name="lib/box3d/src/bitset.c" />
		<file name="lib/box3d/src/block_allocator.c" />
		<file name="lib/box3d/src/body.c" />
		<file name="lib/box3d/src/broad_phase.c" />
		<file name="lib/box3d/src/capsule.c" />
		<file name="lib/box3d/src/compound.c" />
		<file name="lib/box3d/src/constraint_graph.c" />
		<file name="lib/box3d/src/contact.c" />
		<file name="lib/box3d/src/contact_solver.c" />
		<file name="lib/box3d/src/convex_manifold.c" />
		<file name="lib/box3d/src/core.c" />
		<file name="lib/box3d/src/distance.c" />
		<file name="lib/box3d/src/distance_joint.c" />
		<file name="lib/box3d/src/dynamic_tree.c" />
		<file name="lib/box3d/src/height_field.c" />
		<file name="lib/box3d/src/hull.c" />
		<file name="lib/box3d/src/id_pool.c" />
		<file name="lib/box3d/src/island.c" />
		<file name="lib/box3d/src/joint.c" />
		<file name="lib/box3d/src/manifold.c" />
		<file name="lib/box3d/src/math_functions.c" />
		<file name="lib/box3d/src/mesh.c" />
		<file name="lib/box3d/src/mesh_contact.c" />
		<file name="lib/box3d/src/motor_joint.c" />
		<file name="lib/box3d/src/mover.c" />
		<file name="lib/box3d/src/name_cache.c" />
		<file name="lib/box3d/src/parallel_for.c" />
		<file name="lib/box3d/src/parallel_joint.c" />
		<file name="lib/box3d/src/physics_world.c" />
		<file name="lib/box3d/src/prismatic_joint.c" />
		<file name="lib/box3d/src/recording.c" />
		<file name="lib/box3d/src/recording_replay.c" />
		<file name="lib/box3d/src/world_snapshot.c" />
		<file name="lib/box3d/src/revolute_joint.c" />
		<file name="lib/box3d/src/scheduler.c" />
		<file name="lib/box3d/src/sensor.c" />
		<file name="lib/box3d/src/shape.c" />
		<file name="lib/box3d/src/simd.c" />
		<file name="lib/box3d/src/solver.c" />
		<file name="lib/box3d/src/solver_set.c" />
		<file name="lib/box3d/src/sphere.c" />
		<file name="lib/box3d/src/spherical_joint.c" />
		<file name="lib/box3d/src/table.c" />
		<file name="lib/box3d/src/timer.c" />
		<file name="lib/box3d/src/triangle_manifold.c" />
		<file name="lib/box3d/src/types.c" />
		<file name="lib/box3d/src/weld_joint.c" />
		<file name="lib/box3d/src/wheel_joint.c" />
		
	</files>
	
	<files id="common">
		<compilerflag value="-Iinclude"/>
		<compilerflag value="-Ilib/box3d/include/" if="LIME_BOX3D" />
		<compilerflag value="-DLIME_BOX3D" if="LIME_BOX3D" />
		<file name="common/Box3DBindings.cpp"/>
	</files>
	
	<set name="SLIBEXT" value=".lib" if="windows"/>
	<set name="SLIBEXT" value=".a" unless="windows"/>
	<set name="SLIBEXT" value=".so" if="webos"/>
	
	<set name="DEBUGEXTRA" value="-debug" if="fulldebug" />
	
	<target id="NDLL" output="${LIBPREFIX}box3d${DEBUGEXTRA}" tool="linker" toolid="${STD_MODULE_LINK}">
		<outdir name="../ndll/${BINDIR}"/>
		<ext value=".ndll" if="windows || mac || linux"/>
		
		<files id="box3d" if="LIME_BOX3D"/>
		<files id="common"/>
	</target>
	
	<target id="default">
		
		<target id="NDLL"/>
		
	</target>
	
</xml>